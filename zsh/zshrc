# ============================================================
# Oh My Zsh
# ============================================================

# Path to Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set theme.
ZSH_THEME="random"

# Plugins.
plugins=(
  git
  z
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh_codex
  ah
)

# Load Oh My Zsh.
source "$ZSH/oh-my-zsh.sh"


# ============================================================
# Shell / Keybindings
# ============================================================

# Enable completion helper.
bindkey '^X' create_completion

# Disable terminal flow control for Ctrl-S / Ctrl-Q.
stty start undef
stty stop undef
setopt noflowcontrol


# ============================================================
# Homebrew
# ============================================================

# Initialize Homebrew environment.
#
# This adds /opt/homebrew/bin and other Homebrew paths.
eval "$(/opt/homebrew/bin/brew shellenv)"

# Prevent Homebrew from automatically updating.
export HOMEBREW_NO_AUTO_UPDATE=1


# ============================================================
# General PATH
# ============================================================

# User local binaries.
export PATH="$HOME/.local/bin:$PATH"

# System / Intel Homebrew binaries.
#
# /usr/local/bin is kept because the machine still uses
# some Intel/x86_64 tools through Rosetta.
export PATH="/usr/local/bin:$PATH"

# PostgreSQL client tools.
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# V8 3.15.
export PATH="/usr/local/opt/v8@3.15/bin:$PATH"

# Deno.
export PATH="$HOME/.deno/bin:$PATH"

# OpenSSL 3.
#
# Keep OpenSSL 3 binaries available globally, but do NOT
# export LDFLAGS / CPPFLAGS / PKG_CONFIG_PATH globally.
export PATH="/opt/homebrew/opt/openssl@3/bin:$PATH"


# ============================================================
# pnpm
# ============================================================

export PNPM_HOME="$HOME/Library/pnpm"

case ":$PATH:" in
  *":$PNPM_HOME:"*)
    ;;
  *)
    export PATH="$PNPM_HOME:$PATH"
    ;;
esac


# ============================================================
# Docker
# ============================================================

# Enable Docker BuildKit.
export DOCKER_BUILDKIT=1

# Docker Desktop CLI completions.
if [ -d "$HOME/.docker/completions" ]; then
  fpath=("$HOME/.docker/completions" $fpath)

  autoload -Uz compinit
  compinit
fi


# ============================================================
# fzf
# ============================================================

if [ -f "$HOME/.fzf.zsh" ]; then
  source "$HOME/.fzf.zsh"
fi


# ============================================================
# Personal environment
# ============================================================

# Load personal environment variables.
if [ -f "$HOME/.dotfiles/.env" ]; then
  source "$HOME/.dotfiles/.env"
fi


# ============================================================
# Personal aliases and functions
# ============================================================

if [ -f "$HOME/dotfiles/zsh/aliases.zsh" ]; then
  source "$HOME/dotfiles/zsh/aliases.zsh"
fi


# ============================================================
# Deno utilities
# ============================================================

function denoflare {
  deno run \
    --unstable-worker-options \
    --allow-read \
    --allow-net \
    --allow-env \
    --allow-run \
    https://raw.githubusercontent.com/skymethod/denoflare/v0.6.0/cli/cli.ts \
    "$@"
}


# ============================================================
# Architecture helpers
# ============================================================

# Run Intel Homebrew under Rosetta.
alias ibrew='arch -x86_64 /usr/local/bin/brew'


# ============================================================
# Ruby / rbenv
# ============================================================

# IMPORTANT:
# This machine uses Homebrew rbenv.
#
# rbenv root:
#   /opt/homebrew/opt/rbenv
#
# Do NOT add:
#   $HOME/.rbenv/bin
#   $HOME/.rbenv/shims
#   /opt/homebrew/opt/ruby/bin
#
# rbenv init modifies PATH so its shims take precedence.
#
# Keep this initialization AFTER all PATH modifications above.
eval "$(rbenv init - zsh)"


# ============================================================
# Prompt
# ============================================================

# Load Powerlevel10k configuration if available.
if [[ -f "$HOME/.p10k.zsh" ]]; then
  source "$HOME/.p10k.zsh"
fi
